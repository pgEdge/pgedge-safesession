SELECT ss_lk_try('SET SESSION AUTHORIZATION safesession_lk_auth');
                                 ss_lk_try                                 
---------------------------------------------------------------------------
 42501: cannot change role again after the role switch in this transaction
(1 row)

SELECT ss_lk_try('SET ROLE NONE');
