HINT:  pgedge_safesession refuses this after a delegating role (pgedge_safesession.delegating_roles) switches role, so a request leaves nothing behind.
ROLLBACK;
BEGIN;
SELECT set_config('role', 'safesession_lk_user', true);
     set_config      
---------------------
 safesession_lk_user
(1 row)

SELECT ss_lk_try('PREPARE ss_lk_mine AS SELECT 1');
                              ss_lk_try                              
---------------------------------------------------------------------
