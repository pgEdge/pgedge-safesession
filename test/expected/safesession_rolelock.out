-- Test 4: a pool that sets the role in one statement and the settings in
-- the next is refused once the settings are held: set them in the same
-- statement as the role, or before it.
-------------------------------------------------------------------------
BEGIN;
SET LOCAL ROLE safesession_lk_user;
SET LOCAL request.jwt.claims = '{"sub": "1"}';
ERROR:  cannot change request settings after the role switch in this transaction
HINT:  pgedge_safesession lets a delegating role (pgedge_safesession.delegating_roles) switch role once per transaction; after that, the role and the settings named by pgedge_safesession.locked_setting_prefixes cannot change.
ROLLBACK;
BEGIN;
SET LOCAL request.jwt.claims = '{"sub": "1"}';
SET LOCAL ROLE safesession_lk_user;
SELECT * FROM ss_lk_notes;
 owner | val 
-------+-----
 1     | one
(1 row)

COMMIT;
-------------------------------------------------------------------------
-- Test 5: savepoints. A switch inside a savepoint that rolls back never
-- happened, so the next one is allowed. A request's own savepoint cannot
-- undo the lock.
-------------------------------------------------------------------------
BEGIN;
SAVEPOINT a;
SELECT set_config('role', 'safesession_lk_admin', true);
      set_config      
----------------------
 safesession_lk_admin
(1 row)

ROLLBACK TO a;
SELECT current_user;
    current_user     
---------------------
 safesession_lk_auth
(1 row)

SELECT set_config('role', 'safesession_lk_user', true);
     set_config      
---------------------
 safesession_lk_user
(1 row)

SELECT current_user;
    current_user     
---------------------
 safesession_lk_user
(1 row)

SAVEPOINT b;
SELECT ss_lk_try('SET LOCAL ROLE safesession_lk_admin');
                                 ss_lk_try                                 
---------------------------------------------------------------------------
 42501: cannot change role again after the role switch in this transaction
(1 row)

ROLLBACK TO b;
SELECT ss_lk_try('SET LOCAL ROLE safesession_lk_admin');
                                 ss_lk_try                                 
---------------------------------------------------------------------------
 42501: cannot change role again after the role switch in this transaction
(1 row)

RELEASE b;
SELECT current_user;
    current_user     
---------------------
 safesession_lk_user
(1 row)

COMMIT;
-- A switch in a savepoint that is released belongs to the transaction
BEGIN;
SAVEPOINT a;
SELECT set_config('role', 'safesession_lk_user', true);
     set_config      
---------------------
 safesession_lk_user
(1 row)

RELEASE a;
SELECT ss_lk_try('SET LOCAL ROLE safesession_lk_admin');
                                 ss_lk_try                                 
---------------------------------------------------------------------------
 42501: cannot change role again after the role switch in this transaction
(1 row)

COMMIT;
