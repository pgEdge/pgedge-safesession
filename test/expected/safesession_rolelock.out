SELECT set_config('role', 'safesession_lk_user', true);
     set_config      
---------------------
 safesession_lk_user
(1 row)

ALTER DATABASE :"ss_lk_dbname" SET work_mem = '7777kB';
ERROR:  cannot run ALTER DATABASE ... SET or RESET after the role switch in this transaction
