-- Test 21: after the switch, a request cannot PREPARE, which would leave
-- a prepared statement for the next request, or DEALLOCATE, which would
-- remove one the pool uses. The pool's own statement still runs.
-------------------------------------------------------------------------
SET SESSION AUTHORIZATION safesession_lk_auth;
PREPARE ss_lk_pool AS SELECT current_user::text AS who;
BEGIN;
SELECT set_config('role', 'safesession_lk_user', true);
     set_config      
---------------------
 safesession_lk_user
(1 row)

PREPARE ss_lk_mine AS SELECT 1;
ERROR:  cannot run PREPARE after the role switch in this transaction
DETAIL:  It would leave a prepared statement for the next request on the connection.
HINT:  pgedge_safesession refuses this after a delegating role (pgedge_safesession.delegating_roles) switches role, so a request leaves nothing behind.
ROLLBACK;
BEGIN;
SELECT set_config('role', 'safesession_lk_user', true);
     set_config      
---------------------
 safesession_lk_user
(1 row)

DEALLOCATE ss_lk_pool;
ERROR:  cannot run DEALLOCATE after the role switch in this transaction
