 ${misc:Depends},
 pgedge-postgresql-PG_MAJOR_VERSION,
 ${shlibs:Depends},
Conflicts:
 postgresql-PG_MAJOR_VERSION-safesession,
Provides:
 postgresql-PG_MAJOR_VERSION-safesession,
