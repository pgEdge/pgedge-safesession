#!/usr/bin/make -f

%:
	dh $@

override_dh_builddeb:
	dh_builddeb -- -Zgzip

# The top-level Makefile aliases `test` to `installcheck`, so the default
# dh_auto_test would try to run the regression suite against a live server
# with pgedge_safesession preloaded — neither exists during a package build.
# The suite runs in ci.yml instead.
override_dh_auto_test:

execute_before_dh_install:
	# --- SBOM generation and signing ---
	mkdir -p debian/tmp/sbom
	syft dir:$(CURDIR) -o cyclonedx-json > debian/tmp/sbom/pgedge-safesession-sbom.json || exit 1
	KEY_ID=$(gpg --list-secret-keys --with-colons | awk -F: '/^sec/{print $5}' | head -n 1); export KEY_ID
	gpg --armor --detach-sign \
		--output debian/tmp/sbom/pgedge-safesession-sbom.json.asc \
		debian/tmp/sbom/pgedge-safesession-sbom.json || exit 1

override_dh_installdocs:
	dh_installdocs --all README.*
